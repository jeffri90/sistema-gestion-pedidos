<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<div class="page-heading"><div><p class="eyebrow">OPERACIÓN</p><h1>Pedidos</h1><p class="text-secondary">Consulta borradores, pedidos confirmados y cancelaciones.</p></div><c:if test="${operador}"><a class="btn btn-primary" href="${b}/pedidos/nuevo">+ Nuevo pedido</a></c:if></div>
<section class="panel"><form class="p-4 row g-3 align-items-end" method="get" action="${b}/pedidos"><div class="col-md-5"><label class="form-label" for="clienteId">Cliente</label><select class="form-select" name="clienteId" id="clienteId"><option value="">Todos los distribuidores</option><c:forEach items="${clientes}" var="c"><option value="${c.id()}" ${clienteId == c.id() ? 'selected' : ''}><c:out value="${c.razonSocial()}"/></option></c:forEach></select></div><div class="col-md-4"><label class="form-label" for="estado">Estado</label><select class="form-select" name="estado" id="estado"><option value="">Todos los estados</option><c:forEach items="${['BORRADOR','CONFIRMADO','CANCELADO']}" var="e"><option ${estado == e ? 'selected' : ''}>${e}</option></c:forEach></select></div><div class="col-md-3"><button class="btn btn-dark">Filtrar</button><a href="${b}/pedidos" class="btn btn-light">Limpiar</a></div></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Pedido</th><th>Distribuidor</th><th>Fecha</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody><c:forEach items="${pedidos}" var="p"><tr><td>#${p.id()}</td><td><c:out value="${p.cliente()}"/></td><td>${fn:replace(fn:substring(p.fecha(),0,16),'T',' ')}</td><td><span class="status status-${p.estado()}">${p.estado()}</span></td><td>S/ <fmt:formatNumber value="${p.total()}" minFractionDigits="2"/></td><td><a class="btn btn-sm btn-outline-secondary" href="${b}/pedidos/${p.id()}">Ver detalle</a></td></tr></c:forEach><c:if test="${empty pedidos}"><tr><td colspan="6" class="empty-state">No hay pedidos para los filtros seleccionados.</td></tr></c:if></tbody></table></div></section>

<%@ include file="fragments/footer.jspf" %>
