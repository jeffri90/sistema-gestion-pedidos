<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<div class="page-heading"><div><p class="eyebrow">DISTRIBUCIÓN</p><h1>Clientes</h1><p class="text-secondary">Mantén los datos de contacto y entrega de tus distribuidores.</p></div><a class="btn btn-primary" href="${b}/clientes/nuevo">+ Nuevo cliente</a></div>
<section class="panel"><div class="table-responsive"><table class="table align-middle"><thead><tr><th>RUC</th><th>Razón social</th><th>Contacto</th><th>Dirección</th><th>Acciones</th></tr></thead><tbody><c:forEach items="${clientes}" var="c"><tr><td><c:out value="${c.ruc()}"/></td><td class="fw-semibold"><c:out value="${c.razonSocial()}"/></td><td><c:out value="${c.email()}"/><small class="d-block text-secondary"><c:out value="${c.telefono()}"/></small></td><td><c:out value="${c.direccion()}"/></td><td><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-secondary" href="${b}/clientes/${c.id()}/editar">Editar</a><form method="post" action="${b}/clientes/${c.id()}/eliminar"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></div></td></tr></c:forEach><c:if test="${empty clientes}"><tr><td colspan="5" class="empty-state">Registra tu primer distribuidor para crear pedidos.</td></tr></c:if></tbody></table></div></section>

<%@ include file="fragments/footer.jspf" %>
