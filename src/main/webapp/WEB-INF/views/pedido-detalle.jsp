<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<div class="page-heading"><div><p class="eyebrow">OPERACIÓN</p><h1>Pedido #${pedido.id()}</h1><p class="text-secondary">Revisa los productos y continúa con la gestión del pedido.</p></div><a class="btn btn-outline-secondary" href="${b}/pedidos">Volver a pedidos</a></div>
<section class="panel"><div class="panel-heading"><div><h2><c:out value="${pedido.cliente()}"/></h2><p class="text-secondary mb-0">${fn:replace(fn:substring(pedido.fecha(),0,16),'T',' ')}</p></div><span class="status status-${pedido.estado()}">${pedido.estado()}</span></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio unitario</th><th>Subtotal</th></tr></thead><tbody><c:forEach items="${pedido.items()}" var="i"><tr><td class="fw-semibold"><c:out value="${i.producto()}"/></td><td>${i.cantidad()}</td><td>S/ <fmt:formatNumber value="${i.precioUnitario()}" minFractionDigits="2"/></td><td>S/ <fmt:formatNumber value="${i.subtotal()}" minFractionDigits="2"/></td></tr></c:forEach></tbody></table></div><div class="order-total"><span>Total del pedido</span><strong>S/ <fmt:formatNumber value="${pedido.total()}" minFractionDigits="2" maxFractionDigits="2"/></strong></div></section>
<div class="d-flex flex-wrap gap-3 mt-4"><c:if test="${operador and pedido.estado() == 'BORRADOR'}"><form method="post" action="${b}/pedidos/${pedido.id()}/confirmar"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-primary">Confirmar pedido</button></form><a class="btn btn-outline-secondary" href="${b}/pedidos/${pedido.id()}/editar">Editar borrador</a></c:if><c:if test="${operador and pedido.estado() != 'CANCELADO'}"><form method="post" action="${b}/pedidos/${pedido.id()}/cancelar"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-outline-danger">Cancelar pedido</button></form></c:if><c:if test="${admin and pedido.estado() != 'CONFIRMADO'}"><form method="post" action="${b}/pedidos/${pedido.id()}/eliminar"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-outline-danger">Eliminar pedido</button></form></c:if></div>

<%@ include file="fragments/footer.jspf" %>
