<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<div class="page-heading"><div><p class="eyebrow">DISTRIBUCIÓN</p><h1>${empty cliente ? 'Nuevo cliente' : 'Editar cliente'}</h1><p class="text-secondary">Registra al distribuidor que recibirá los productos.</p></div></div><form class="panel form-panel" method="post" action="${b}/clientes/guardar"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><c:if test="${not empty cliente}"><input type="hidden" name="id" value="${cliente.id()}"></c:if><div class="row g-4"><div class="col-md-4"><label class="form-label" for="ruc">RUC</label><input id="ruc" name="ruc" type="text" class="form-control" required pattern="[0-9]{11}" maxlength="11" value="${empty cliente ? '' : fn:escapeXml(cliente.ruc())}"></div><div class="col-md-8"><label class="form-label" for="razonSocial">Razón social</label><input id="razonSocial" name="razonSocial" type="text" class="form-control" required maxlength="120" value="${empty cliente ? '' : fn:escapeXml(cliente.razonSocial())}"></div><div class="col-md-6"><label class="form-label" for="email">Correo electrónico</label><input id="email" name="email" type="email" class="form-control" required maxlength="150" value="${empty cliente ? '' : fn:escapeXml(cliente.email())}"></div><div class="col-md-6"><label class="form-label" for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" class="form-control" required minlength="7" maxlength="20" value="${empty cliente ? '' : fn:escapeXml(cliente.telefono())}"></div><div class="col-12"><label class="form-label" for="direccion">Dirección de entrega</label><input id="direccion" name="direccion" type="text" class="form-control" required maxlength="200" value="${empty cliente ? '' : fn:escapeXml(cliente.direccion())}"></div></div><div class="form-actions"><button class="btn btn-primary">Guardar cliente</button><a class="btn btn-light" href="${b}/clientes">Volver a clientes</a></div></form>
<%@ include file="fragments/footer.jspf" %>
