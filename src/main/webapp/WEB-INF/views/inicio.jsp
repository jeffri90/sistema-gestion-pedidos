<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<div class="page-heading"><div><p class="eyebrow">OPERACIÓN COMERCIAL</p><h1>Cada pedido, bajo control.</h1><p class="text-secondary">Consulta tu catálogo, organiza distribuidores y gestiona pedidos desde un solo lugar.</p></div><c:if test="${operador}"><a class="btn btn-primary" href="${b}/pedidos/nuevo">+ Nuevo pedido</a></c:if></div>
<div class="row g-3 mb-4"><div class="col-6 col-xl-3"><section class="metric"><span>Productos en catálogo</span><strong>${fn:length(productos)}</strong><small>Listos para cotizar</small></section></div><div class="col-6 col-xl-3"><section class="metric"><span>Clientes registrados</span><strong>${fn:length(clientes)}</strong><small>Red de distribuidores</small></section></div><div class="col-6 col-xl-3"><section class="metric"><span>Pedidos en borrador</span><strong>${pendientes}</strong><small>Pendientes de confirmar</small></section></div><div class="col-6 col-xl-3"><section class="metric"><span>Pedidos confirmados</span><strong>${confirmados}</strong><small>Stock descontado</small></section></div></div>
<section class="panel"><div class="panel-heading"><div><h2>Pedidos recientes</h2><p class="text-secondary mb-0">Revisa el estado y el importe de las últimas solicitudes.</p></div><a href="${b}/pedidos" class="text-link">Ver todos →</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Pedido</th><th>Distribuidor</th><th>Estado</th><th>Total</th><th></th></tr></thead><tbody><c:forEach items="${pedidos}" var="p" end="5"><tr><td class="fw-semibold">#${p.id()}</td><td><c:out value="${p.cliente()}"/></td><td><span class="status status-${p.estado()}">${p.estado()}</span></td><td>S/ <fmt:formatNumber value="${p.total()}" minFractionDigits="2" maxFractionDigits="2"/></td><td><a class="btn btn-sm btn-outline-secondary" href="${b}/pedidos/${p.id()}">Ver detalle</a></td></tr></c:forEach><c:if test="${empty pedidos}"><tr><td colspan="5" class="empty-state">Todavía no hay pedidos. Crea el primero para iniciar el flujo de distribución.</td></tr></c:if></tbody></table></div></section>
<div class="flow-note mt-4"><strong>Un flujo claro</strong><span>01 · Crea un borrador</span><span>02 · Confirma y descuenta stock</span><span>03 · Consulta o cancela</span></div>

<%@ include file="fragments/footer.jspf" %>
