<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<div class="page-heading"><div><p class="eyebrow">OPERACIÓN</p><h1>${empty pedido ? 'Nuevo pedido' : 'Editar borrador'}</h1><p class="text-secondary">Selecciona un distribuidor y agrega hasta cuatro productos distintos.</p></div></div>
<form class="panel form-panel" method="post" action="${b}/pedidos/guardar"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><c:if test="${not empty pedido}"><input name="id" type="hidden" value="${pedido.id()}"></c:if><label class="form-label" for="clienteId">Cliente distribuidor</label><select class="form-select mb-4" name="clienteId" id="clienteId" required><option value="">Seleccionar distribuidor</option><c:forEach items="${clientes}" var="c"><option value="${c.id()}" ${not empty pedido and pedido.clienteId() == c.id() ? 'selected' : ''}><c:out value="${c.razonSocial()}"/> · ${c.ruc()}</option></c:forEach></select>
<div class="table-responsive"><table class="table"><thead><tr><th>Línea</th><th>Producto</th><th style="width:130px">Cantidad</th></tr></thead><tbody><c:forEach begin="0" end="3" var="i"><c:set var="linea" value="${not empty pedido and i < fn:length(pedido.items()) ? pedido.items()[i] : null}"/><tr><td>${i+1}</td><td><label class="visually-hidden" for="producto-${i}">Producto ${i+1}</label><select class="form-select" name="productoId" id="producto-${i}" ${i == 0 ? 'required' : ''}><option value="">${i == 0 ? 'Seleccionar producto' : 'Sin producto (opcional)'}</option><c:forEach items="${productos}" var="p"><option value="${p.id()}" ${not empty linea and linea.productoId() == p.id() ? 'selected' : ''}><c:out value="${p.nombre()}"/> · S/ ${p.precio()} · Stock ${p.stock()}</option></c:forEach></select></td><td><label class="visually-hidden" for="cantidad-${i}">Cantidad ${i+1}</label><input class="form-control" id="cantidad-${i}" name="cantidad" type="number" min="1" max="10000" value="${empty linea ? 1 : linea.cantidad()}" required></td></tr></c:forEach></tbody></table></div><div class="alert alert-light border mt-3">El precio y el total se calculan al guardar. El stock se descuenta al confirmar el pedido.</div><div class="form-actions"><button class="btn btn-primary">Guardar borrador</button><a class="btn btn-light" href="${b}/pedidos">Volver a pedidos</a></div></form>

<%@ include file="fragments/footer.jspf" %>
