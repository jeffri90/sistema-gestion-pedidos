<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="b" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Sistema de Gestión de Pedidos</title><link rel="stylesheet" href="${b}/css/bootstrap.min.css"><link rel="stylesheet" href="${b}/css/app.css"></head>
<body><aside class="sidebar"><a class="brand" href="${b}/"><span class="brand-icon">P</span><span>PEDIDOS<small>Portal de distribución</small></span></a><div class="nav-label">GESTIÓN COMERCIAL</div><nav aria-label="Navegación principal"><a href="${b}/">Resumen</a><a href="${b}/pedidos">Pedidos</a><a href="${b}/productos">Productos</a><c:if test="${admin}"><a href="${b}/clientes">Clientes</a><a href="${b}/jsf/cliente.xhtml">Alta de cliente · JSF</a></c:if></nav><div class="sidebar-bottom"><span class="small">Caso académico · Alicorp</span><strong><c:out value="${pageContext.request.userPrincipal.name}"/></strong><form method="post" action="${b}/logout"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-outline-light btn-sm w-100">Cerrar sesión</button></form></div></aside>
<div class="workspace"><header class="topbar"><span>Sistema de Gestión de Pedidos</span><span class="badge text-bg-light">APF2 · Distribuidores</span></header><main class="main-content"><c:if test="${not empty mensaje}"><div class="alert alert-success" role="status"><c:out value="${mensaje}"/></div></c:if>
