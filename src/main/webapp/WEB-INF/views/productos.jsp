<%@ page pageEncoding="UTF-8" %>
<%@ include file="fragments/header.jspf" %>
<div class="page-heading"><div><p class="eyebrow">CATÁLOGO</p><h1>Productos</h1><p class="text-secondary">Administra precios y existencias disponibles para los pedidos.</p></div><c:if test="${admin}"><a class="btn btn-primary" href="${b}/productos/nuevo">+ Nuevo producto</a></c:if></div>
<section class="panel"><form class="p-4 d-flex gap-2" method="get" action="${b}/productos"><label class="visually-hidden" for="texto">Buscar por nombre o SKU</label><input id="texto" name="texto" value="${fn:escapeXml(texto)}" class="form-control" placeholder="Buscar por nombre o SKU" maxlength="120"><button class="btn btn-dark">Buscar</button><a class="btn btn-light" href="${b}/productos">Limpiar</a></form><div class="table-responsive"><table class="table align-middle"><thead><tr><th>SKU</th><th>Producto</th><th>Categoría</th><th>Precio</th><th>Stock</th><c:if test="${admin}"><th>Acciones</th></c:if></tr></thead><tbody><c:forEach items="${productos}" var="p"><tr><td><c:out value="${p.sku()}"/></td><td class="fw-semibold"><c:out value="${p.nombre()}"/></td><td><c:out value="${p.categoria()}"/></td><td>S/ <fmt:formatNumber value="${p.precio()}" minFractionDigits="2"/></td><td><span class="stock-count">${p.stock()}</span></td><c:if test="${admin}"><td><div class="d-flex gap-2"><a class="btn btn-sm btn-outline-secondary" href="${b}/productos/${p.id()}/editar">Editar</a><form method="post" action="${b}/productos/${p.id()}/eliminar"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><button class="btn btn-sm btn-outline-danger">Eliminar</button></form></div></td></c:if></tr></c:forEach><c:if test="${empty productos}"><tr><td colspan="6" class="empty-state">No se encontraron productos.</td></tr></c:if></tbody></table></div></section>

<%@ include file="fragments/footer.jspf" %>
