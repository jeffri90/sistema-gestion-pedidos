<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<c:set var="b" value="${pageContext.request.contextPath}"/>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Ingresar · Sistema de Gestión de Pedidos</title><link rel="stylesheet" href="${b}/css/bootstrap.min.css"><link rel="stylesheet" href="${b}/css/app.css"></head><body class="login-page"><main class="login-shell"><section class="login-intro"><span class="brand-icon mb-5">P</span><p class="eyebrow">PORTAL DE DISTRIBUCIÓN</p><h1>Tu operación.<br>En un solo lugar.</h1><p>Productos, distribuidores y pedidos conectados para trabajar con más orden.</p><div class="login-foot">Sistema de Gestión de Pedidos<br><small>Propuesta académica · Caso Alicorp</small></div></section><section class="login-form"><h2>Bienvenido</h2><p class="text-secondary mb-4">Ingresa con tu cuenta para continuar.</p><c:if test="${param.error != null}"><div class="alert alert-danger">Usuario o contraseña incorrectos.</div></c:if><c:if test="${param.logout != null}"><div class="alert alert-success">Sesión cerrada.</div></c:if><form method="post" action="${b}/login"><input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}"><div class="mb-4"><label class="form-label" for="username">Usuario</label><input class="form-control form-control-lg" id="username" name="username" autocomplete="username" required autofocus></div><div class="mb-4"><label class="form-label" for="password">Contraseña</label><input class="form-control form-control-lg" id="password" name="password" type="password" autocomplete="current-password" required></div><button class="btn btn-primary btn-lg w-100">Ingresar</button></form><p class="small text-secondary mt-4 mb-0">Solicita tus credenciales al administrador del sistema.</p></section></main></body></html>
